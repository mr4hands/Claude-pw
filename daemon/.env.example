# The broker to dial out to.
BROKER_URL=wss://broker.example.com

# Printed by the broker's mint CLI:  npm run mint -- --daemon --account default
DAEMON_TOKEN=

# Project directory whose sessions this daemon serves. Defaults to cwd.
WORKDIR=.

# Permission mode for resumed sessions. Leave as default so tool calls actually
# reach canUseTool — that is the whole point of the watch.
# PERMISSION_MODE=default
