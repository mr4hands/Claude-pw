# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Everything the broker trusts derives from this. Rotating it invalidates every
# daemon and device token at once.
BROKER_SECRET=

# Optional. Where to persist revoked token ids so a revocation survives restart.
# Without it, revocations are lost when the process dies.
BROKER_STATE_FILE=./broker-state.json

PORT=8787
